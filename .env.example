PUBLIC_SITE_NAME="El Canaveral Info"
PUBLIC_SITE_URL=https://elcanaveral.info
GEMINI_API_KEY=AIza...

# Analítica sin cookies. Si PUBLIC_ANALYTICS_ID está vacío no se carga ningún script.
# Plausible (recomendado): PUBLIC_ANALYTICS_ID=elcanaveral.info
#   PUBLIC_ANALYTICS_PROVIDER puede omitirse o valer "plausible".
# Umami (autohospedado): PUBLIC_ANALYTICS_PROVIDER=umami
#   PUBLIC_ANALYTICS_ID=<website id>
#   PUBLIC_ANALYTICS_SRC=https://tu-umami.example/script.js
#   Si falta el src, no se carga nada.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_ID=
PUBLIC_ANALYTICS_SRC=

# Auditoría gratis: https://localseoads.com/auditoria-gratis/el-canaveral/
# Activa por defecto (el CTA se pinta sin esta variable). "false" lo oculta.
# PUBLIC_AUDIT_LANDING_LIVE=false

# URL /exec del Apps Script de la hoja CRM. Vacía = no se envía nada.
# No pegar aquí la URL real. Pasos: docs/crm-setup.md
SHEETS_WEBHOOK_URL=
