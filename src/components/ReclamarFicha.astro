---
import type { Negocio } from "@/lib/directory";
import {
  UTM_MEDIUM,
  UTM_SOURCE,
  UBICACION_POR_DEFECTO,
  auditoriaLandingActiva,
  enlaceAuditoriaGratis,
  enlaceWhatsappReclamar,
} from "@/lib/localseoads";

interface Props {
  negocio: Negocio;
}

const { negocio } = Astro.props;
const zona = negocio.zona || UBICACION_POR_DEFECTO;
const utm = `utm_source=${UTM_SOURCE}&utm_medium=${UTM_MEDIUM}&utm_campaign=${zona}&utm_content=${negocio.slug}`;
const whatsapp = enlaceWhatsappReclamar(negocio);
const auditoria = auditoriaLandingActiva()
  ? enlaceAuditoriaGratis({ ubicacion: zona, content: negocio.slug, ficha: negocio.slug })
  : undefined;
const formId = `reclamar-${negocio.slug}`;
---

<div class="rounded-xl border border-warm-200 bg-white p-5">
  <details class="group">
    <summary class="list-none cursor-pointer text-center text-sm font-semibold text-brand-700 border border-brand-200 rounded-lg py-2.5 hover:bg-brand-50 transition-colors">
      ¿Es tu negocio? Reclámala
    </summary>
    <form
      name="reclamar-ficha"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action={`/gracias/?ficha=${negocio.slug}`}
      class="mt-4 space-y-3"
    >
      <input type="hidden" name="form-name" value="reclamar-ficha" />
      <input type="hidden" name="ficha" value={negocio.name} />
      <input type="hidden" name="slug" value={negocio.slug} />
      <input type="hidden" name="categoria" value={negocio.category} />
      <input type="hidden" name="utm" value={utm} />
      <p class="hidden"><label>No rellenar: <input name="bot-field" /></label></p>

      <div>
        <label for={`${formId}-nombre`} class="block text-xs font-semibold text-brand-900 mb-1">Tu nombre *</label>
        <input id={`${formId}-nombre`} name="nombre" type="text" required class="w-full px-3 py-2 text-sm border border-warm-300 rounded-lg focus:outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label for={`${formId}-email`} class="block text-xs font-semibold text-brand-900 mb-1">Email *</label>
        <input id={`${formId}-email`} name="email" type="email" required class="w-full px-3 py-2 text-sm border border-warm-300 rounded-lg focus:outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label for={`${formId}-telefono`} class="block text-xs font-semibold text-brand-900 mb-1">Teléfono</label>
        <input id={`${formId}-telefono`} name="telefono" type="tel" class="w-full px-3 py-2 text-sm border border-warm-300 rounded-lg focus:outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label for={`${formId}-mensaje`} class="block text-xs font-semibold text-brand-900 mb-1">Qué quieres corregir</label>
        <textarea id={`${formId}-mensaje`} name="mensaje" rows="3" class="w-full px-3 py-2 text-sm border border-warm-300 rounded-lg focus:outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-100"></textarea>
      </div>
      <label class="flex items-start gap-2 text-xs text-warm-700">
        <input type="checkbox" name="acepto-rgpd" required class="mt-0.5" />
        <span>
          Acepto la <a href="/privacidad/" class="text-brand-700 underline">política de privacidad</a>.
        </span>
      </label>
      <button type="submit" class="w-full bg-brand-900 text-white text-sm font-semibold py-2.5 rounded-lg hover:bg-brand-800 transition-colors">
        Enviar reclamación
      </button>
    </form>
  </details>

  {whatsapp && (
    <a
      href={whatsapp}
      target="_blank"
      rel="noopener"
      class="mt-3 block text-center text-sm font-semibold text-white bg-[#25D366] rounded-lg py-2.5 hover:opacity-90 transition-opacity"
    >
      Reclamar por WhatsApp
    </a>
  )}

  {auditoria && (
    <a
      href={auditoria}
      target="_blank"
      rel="noopener"
      class="mt-3 block text-center text-sm font-semibold text-brand-900 border border-brand-200 rounded-lg py-2.5 hover:bg-brand-50 transition-colors"
    >
      Auditoría gratis de tu ficha
    </a>
  )}
</div>
