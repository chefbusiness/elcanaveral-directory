---
interface Props {
  nombre: "sugerir-apertura" | "sugerir-evento";
  titulo: string;
  introduccion: string;
  etiquetaAsunto: string;
}

const { nombre, titulo, introduccion, etiquetaAsunto } = Astro.props;
---

<section class="mt-12 bg-white border border-warm-200 rounded-2xl p-6 sm:p-8" id={nombre}>
  <h2 class="text-xl font-bold text-brand-900">{titulo}</h2>
  <p class="text-sm text-gray-600 mt-2 mb-5 leading-relaxed">{introduccion}</p>
  <form
    name={nombre}
    method="POST"
    action="/gracias/"
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="space-y-4"
  >
    <input type="hidden" name="form-name" value={nombre} />
    <p class="hidden"><label>No rellenar: <input name="bot-field" /></label></p>

    <div>
      <label for={`${nombre}-nombre`} class="block text-sm font-semibold text-brand-900 mb-1">Tu nombre *</label>
      <input id={`${nombre}-nombre`} name="nombre" type="text" required autocomplete="name" class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-100" />
    </div>
    <div>
      <label for={`${nombre}-email`} class="block text-sm font-semibold text-brand-900 mb-1">Email *</label>
      <input id={`${nombre}-email`} name="email" type="email" required autocomplete="email" class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-100" />
    </div>
    <div>
      <label for={`${nombre}-asunto`} class="block text-sm font-semibold text-brand-900 mb-1">{etiquetaAsunto} *</label>
      <input id={`${nombre}-asunto`} name="asunto" type="text" required class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-100" />
    </div>
    <div>
      <label for={`${nombre}-fuente`} class="block text-sm font-semibold text-brand-900 mb-1">URL de la fuente *</label>
      <input id={`${nombre}-fuente`} name="url-fuente" type="url" required placeholder="https://" class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-100" />
      <p class="text-xs text-gray-500 mt-1">El enlace de la noticia, el cartel o la web donde se anuncia. Sin esa URL no lo publicamos.</p>
    </div>
    <div>
      <label for={`${nombre}-detalle`} class="block text-sm font-semibold text-brand-900 mb-1">Detalle</label>
      <textarea id={`${nombre}-detalle`} name="detalle" rows="3" class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-100"></textarea>
    </div>
    <label class="flex items-start gap-2 text-sm text-gray-700">
      <input type="checkbox" name="acepto-rgpd" required class="mt-1" />
      <span>
        Acepto la <a href="/privacidad/" class="text-brand-700 underline">política de privacidad</a>.
        El email solo se usa para responder a este aviso.
      </span>
    </label>
    <button type="submit" class="bg-brand-900 text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-brand-800 transition-colors">
      Enviar sugerencia
    </button>
  </form>
</section>
