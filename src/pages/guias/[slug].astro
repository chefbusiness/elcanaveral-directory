---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ReclamarFicha from "@/components/ReclamarFicha.astro";
import guiasData from "@/data/guias.json";
import { getNegocioBySlug, type Negocio } from "@/lib/directory";
import { enlaceCtaLocalseoads } from "@/lib/localseoads";
import { textoFechaLarga } from "@/lib/novedades.mjs";

interface FuenteGuia {
  nombre: string;
  url: string;
  tipo: string;
}

interface ItemGuia {
  id: string;
  grupo: string;
  nombre: string;
  resumen: string;
  direccion?: string;
  telefono?: string;
  whatsapp?: string;
  fichaCategoria?: string;
  fichaSlug?: string;
  fuentes: FuenteGuia[];
  verificadoEn: string;
}

interface Guia {
  slug: string;
  title: string;
  description: string;
  h1: string;
  intro: string;
  actualizado: string;
  items: ItemGuia[];
  faq: { q: string; a: string }[];
}

export function getStaticPaths() {
  return (guiasData as Guia[]).map((guia) => ({
    params: { slug: guia.slug },
    props: { guia },
  }));
}

const guia = Astro.props.guia as Guia;
const renderizados = guia.items;
const base = "https://www.elcanaveral.info";
const pagina = `${base}/guias/${guia.slug}/`;
const revision = textoFechaLarga(guia.actualizado);
const hrefLocal = enlaceCtaLocalseoads({ ubicacion: "el-canaveral", content: "guia-ninos" });

const TITULOS: Record<string, string> = {
  cafeteria: "Cafetería con zona de juegos",
  parque: "Áreas infantiles municipales",
};

function fichaDe(item: ItemGuia): Negocio | undefined {
  if (!item.fichaSlug) return undefined;
  const negocio = getNegocioBySlug(item.fichaSlug);
  if (!negocio) return undefined;
  if (item.fichaCategoria && negocio.category !== item.fichaCategoria) return undefined;
  return negocio;
}

function urlAbsoluta(item: ItemGuia): string {
  const negocio = fichaDe(item);
  if (negocio) return `${base}/${negocio.category}/${negocio.slug}/`;
  return `${pagina}#${item.id}`;
}

function mapaDe(item: ItemGuia): string | null {
  const direccion = item.direccion?.trim();
  if (!direccion) return null;
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(direccion)}`;
}

const partes = (texto: string) => {
  const out: { tipo: "texto" | "url"; valor: string }[] = [];
  const re = /https?:\/\/[^\s)]+/g;
  let last = 0;
  for (const match of texto.matchAll(re)) {
    const index = match.index ?? 0;
    if (index > last) out.push({ tipo: "texto", valor: texto.slice(last, index) });
    out.push({ tipo: "url", valor: match[0] });
    last = index + match[0].length;
  }
  if (last < texto.length) out.push({ tipo: "texto", valor: texto.slice(last) });
  return out;
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: guia.h1,
  numberOfItems: renderizados.length,
  itemListElement: renderizados.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.nombre,
    url: urlAbsoluta(item),
  })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${base}/` },
    { "@type": "ListItem", position: 2, name: "Guías", item: `${base}/guias/` },
    { "@type": "ListItem", position: 3, name: guia.h1, item: pagina },
  ],
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: guia.faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout title={guia.title} description={guia.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />

  <article class="pt-24 pb-16 px-4">
    <div class="max-w-3xl mx-auto">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-brand-600">Inicio</a>
        <span class="mx-1.5 text-gray-300">/</span>
        <a href="/guias/" class="hover:text-brand-600">Guías</a>
        <span class="mx-1.5 text-gray-300">/</span>
        <span class="text-gray-900">{guia.h1}</span>
      </nav>

      <header class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold text-brand-900 leading-tight">{guia.h1}</h1>
        {revision && <p class="text-sm text-gray-500 mt-3">Revisión: {revision}</p>}
        <p class="text-gray-600 mt-4 text-lg leading-relaxed">{guia.intro}</p>
        <p class="text-sm text-gray-600 mt-3">
          Escuelas, salud y el resto del día a día siguen en
          <a href="/con-ninos/" class="text-brand-600 font-medium hover:text-brand-700">El Cañaveral con niños</a>.
        </p>
      </header>

      <ol class="space-y-4 list-none">
        {renderizados.map((item, i) => {
          const negocio = fichaDe(item);
          const href = negocio ? `/${negocio.category}/${negocio.slug}/` : null;
          const mapa = mapaDe(item);
          const titulo = i === 0 || item.grupo !== renderizados[i - 1].grupo ? TITULOS[item.grupo] || "Sitios" : null;
          const verificado = textoFechaLarga(item.verificadoEn);
          return (
            <>
              {titulo && (
                <li class="list-none pt-4">
                  <h2 class="text-2xl font-bold text-brand-900">{titulo}</h2>
                  {item.grupo === "parque" && (
                    <p class="text-sm text-gray-500 mt-1">
                      Inventario del Ayuntamiento de Madrid (CC BY 4.0). El archivo no trae horario.
                    </p>
                  )}
                </li>
              )}
              <li>
                <article id={item.id} class="bg-white rounded-xl border border-warm-200 p-5">
                  <p class="text-xs font-semibold text-gray-400 mb-1">{i + 1}</p>
                  <h3 class="font-bold text-lg text-brand-900">
                    {href ? <a href={href} class="hover:text-brand-600">{item.nombre}</a> : item.nombre}
                  </h3>
                  {item.direccion && <p class="text-sm text-gray-500 mt-1">{item.direccion}</p>}
                  <p class="text-gray-700 text-sm mt-3 leading-relaxed">{item.resumen}</p>
                  {(item.telefono || item.whatsapp || mapa || href) && (
                    <div class="flex flex-wrap gap-x-4 gap-y-2 mt-3 text-sm">
                      {href && <a href={href} class="font-medium text-brand-600 hover:text-brand-700">Ver ficha</a>}
                      {item.telefono && <a href={`tel:${item.telefono}`} class="text-gray-600 hover:text-brand-600">{item.telefono}</a>}
                      {item.whatsapp && (
                        <a href={item.whatsapp} target="_blank" rel="noopener" class="text-gray-600 hover:text-brand-600">WhatsApp</a>
                      )}
                      {mapa && (
                        <a href={mapa} target="_blank" rel="noopener" class="text-gray-600 hover:text-brand-600">Ver en el mapa</a>
                      )}
                    </div>
                  )}
                  <ul class="mt-3 space-y-1">
                    {item.fuentes.map((fuente) => (
                      <li class="text-xs text-gray-500">
                        Fuente: <a href={fuente.url} target="_blank" rel="noopener" class="text-brand-600 hover:text-brand-700">{fuente.nombre}</a>
                        {verificado && <span> · verificado el {verificado}</span>}
                      </li>
                    ))}
                  </ul>
                  {negocio && <div class="mt-4"><ReclamarFicha negocio={negocio} /></div>}
                </article>
              </li>
            </>
          );
        })}
      </ol>

      <section class="mt-12">
        <h2 class="text-2xl font-bold text-brand-900 mb-5">Preguntas frecuentes</h2>
        <div class="space-y-3">
          {guia.faq.map((f) => (
            <details class="bg-white rounded-xl border border-warm-200 p-4 group">
              <summary class="font-semibold text-gray-800 cursor-pointer list-none flex items-center justify-between gap-3">
                {f.q}
                <span class="text-brand-400 group-open:rotate-180 transition-transform">&#9662;</span>
              </summary>
              <p class="text-gray-600 text-sm mt-3 leading-relaxed">
                {partes(f.a).map((parte) =>
                  parte.tipo === "url" ? (
                    <a href={parte.valor} target="_blank" rel="noopener" class="text-brand-600 hover:text-brand-700 break-all">{parte.valor}</a>
                  ) : (
                    parte.valor
                  ),
                )}
              </p>
            </details>
          ))}
        </div>
      </section>

      <aside class="mt-10 bg-brand-900 text-white rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl font-bold">¿Es tuyo uno de estos sitios?</h2>
        <p class="text-brand-100 text-sm mt-2 leading-relaxed">
          Si la ficha ya está en el directorio, reclámala en la tarjeta. Si quieres que se vea más en Google, en LocalSEOAds trabajan el SEO local.
        </p>
        <a
          href={hrefLocal}
          target="_blank"
          rel="noopener"
          class="inline-block mt-4 text-sm font-semibold bg-accent-500 text-white px-4 py-2 rounded-lg hover:bg-accent-600 transition-colors"
        >
          Ver LocalSEOAds
        </a>
      </aside>
    </div>
  </article>

  <Footer />
</BaseLayout>
