---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FormularioSugerencia from "@/components/FormularioSugerencia.astro";
import agendaData from "@/data/agenda.json";
import type { AgendaFile, EstadoAgenda, EventoAgenda } from "@/lib/novedades.mjs";
import { enlaceCtaLocalseoads } from "@/lib/localseoads";
import {
  admiteSchemaEvento,
  clasificarAgenda,
  fechaSchema,
  hoyMadrid,
  porReverificar,
  textoFechaLarga,
  textoIntervalo,
} from "@/lib/novedades.mjs";

const datos = agendaData as AgendaFile;
const hoy = hoyMadrid();
const vistas = clasificarAgenda(datos.items, hoy);
const hrefLocal = enlaceCtaLocalseoads({ ubicacion: "el-canaveral", content: "agenda" });
const base = "https://www.elcanaveral.info";

const etiqueta: Record<EstadoAgenda, string> = {
  confirmado: "Confirmado",
  anunciado: "Anunciado",
  cancelado: "Cancelado",
  aplazado: "Aplazado",
};

function estadoSchema(estado: EstadoAgenda): string {
  switch (estado) {
    case "confirmado":
    case "anunciado":
      return "https://schema.org/EventScheduled";
    case "cancelado":
      return "https://schema.org/EventCancelled";
    case "aplazado":
      return "https://schema.org/EventPostponed";
    default: {
      const nunca: never = estado;
      return nunca;
    }
  }
}

function eventoSchema(ev: EventoAgenda) {
  if (!admiteSchemaEvento(ev)) return null;
  const nodo: Record<string, unknown> = {
    "@type": "Event",
    name: ev.nombre,
    startDate: fechaSchema(ev.inicio, ev.sinHora),
    endDate: fechaSchema(ev.fin, ev.sinHora),
    eventStatus: estadoSchema(ev.estado),
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    location: {
      "@type": "Place",
      name: ev.lugar.nombre,
      address: ev.lugar.direccion,
    },
    description: ev.resumen,
    url: `${base}/agenda/${ev.id}/`,
  };
  if (ev.organizador?.nombre) {
    nodo.organizer = {
      "@type": "Organization",
      name: ev.organizador.nombre,
      ...(ev.organizador.url ? { url: ev.organizador.url } : {}),
    };
  }
  return nodo;
}

const listados = datos.items.map(eventoSchema).filter(Boolean);
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Agenda de El Cañaveral",
  numberOfItems: listados.length,
  itemListElement: listados.map((item, i) => ({ "@type": "ListItem", position: i + 1, item })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${base}/` },
    { "@type": "ListItem", position: 2, name: "Agenda", item: `${base}/agenda/` },
  ],
};

const bloques: { id: string; titulo: string; eventos: EventoAgenda[]; vacio: string }[] = [
  {
    id: "esta-semana",
    titulo: "Esta semana",
    eventos: vistas.semana,
    vacio: "Esta semana no hay ningún evento con fecha y fuente. Los que ya pasaron están en el archivo.",
  },
  {
    id: "este-mes",
    titulo: "Este mes",
    eventos: vistas.mes,
    vacio: "El resto del mes no tiene eventos publicados. Si conoces uno, hace falta el enlace de la convocatoria.",
  },
  {
    id: "proximos-meses",
    titulo: "Próximos meses",
    eventos: vistas.proximos,
    vacio: "No hay eventos confirmados más allá de este mes.",
  },
];
---

<BaseLayout
  title="Agenda de El Cañaveral"
  description="Eventos de El Cañaveral con fecha, lugar y fuente. Esta semana, este mes y los próximos. Lo ya celebrado está en el archivo, sin resultados inventados."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Header />

  <article class="pt-24 pb-16 px-4">
    <div class="max-w-3xl mx-auto">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-brand-600">Inicio</a>
        <span class="mx-1.5 text-gray-300">/</span>
        <span class="text-gray-900">Agenda</span>
      </nav>

      <header class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold text-brand-900 leading-tight">Agenda de El Cañaveral</h1>
        <p class="text-gray-600 mt-4 text-lg leading-relaxed">
          Convocatorias del barrio con inicio, lugar y una fuente que se puede abrir.
          Las fiestas de cada año están en <a href="/fiestas/" class="text-brand-600 font-medium">fiestas y días especiales</a>.
        </p>
      </header>

      {datos.items.length === 0 && (
        <p class="text-gray-600 bg-warm-50 border border-warm-200 rounded-xl p-5 mb-8 leading-relaxed">
          La agenda está vacía porque todavía no hay un evento con fuente enlazable.
          Si tienes la convocatoria, el formulario de abajo pide esa URL.
        </p>
      )}

      {bloques.map((bloque) => (
        <section class="mb-10" id={bloque.id}>
          <h2 class="text-2xl font-bold text-brand-900 mb-4">{bloque.titulo}</h2>
          {bloque.eventos.length > 0 ? (
            <div class="space-y-4">
              {bloque.eventos.map((ev) => (
                <article class="bg-white rounded-xl border border-warm-200 p-5">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class="text-[11px] font-bold uppercase tracking-wide bg-brand-50 text-brand-700 px-2 py-0.5 rounded">{etiqueta[ev.estado]}</span>
                    <span class="text-xs text-gray-500">{textoIntervalo(ev.inicio, ev.fin, ev.sinHora)}</span>
                    {porReverificar(ev.verificadoEn, hoy) && (
                      <span class="text-[11px] font-semibold bg-amber-50 text-amber-800 px-2 py-0.5 rounded">dato por reverificar</span>
                    )}
                  </div>
                  <h3 class="font-bold text-lg text-brand-900">
                    <a href={`/agenda/${ev.id}/`} class="hover:text-brand-600">{ev.nombre}</a>
                  </h3>
                  <p class="text-sm text-gray-500 mt-1">{ev.lugar.nombre}</p>
                  <p class="text-gray-700 text-sm mt-3 leading-relaxed">{ev.resumen}</p>
                  <a href={`/agenda/${ev.id}.ics`} class="inline-block mt-3 text-sm font-medium text-brand-600 hover:text-brand-700">Añadir al calendario (.ics)</a>
                </article>
              ))}
            </div>
          ) : (
            <p class="text-gray-600 bg-warm-50 border border-warm-200 rounded-xl p-5 leading-relaxed">{bloque.vacio}</p>
          )}
        </section>
      ))}

      <section class="mb-10" id="archivo">
        <h2 class="text-2xl font-bold text-brand-900 mb-2">Archivo</h2>
        <p class="text-sm text-gray-500 mb-4">Eventos ya pasados. No salen en la semana, el mes ni los próximos.</p>
        {vistas.archivo.length > 0 ? (
          <div class="space-y-4">
            {vistas.archivo.map((ev) => (
              <article class="bg-white rounded-xl border border-warm-200 p-5">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="text-[11px] font-bold uppercase tracking-wide bg-warm-100 text-gray-600 px-2 py-0.5 rounded">Pasado</span>
                  <span class="text-xs text-gray-500">{textoIntervalo(ev.inicio, ev.fin, ev.sinHora)}</span>
                  {porReverificar(ev.verificadoEn, hoy) && (
                    <span class="text-[11px] font-semibold bg-amber-50 text-amber-800 px-2 py-0.5 rounded">dato por reverificar</span>
                  )}
                </div>
                <h3 class="font-bold text-lg text-brand-900">
                  <a href={`/agenda/${ev.id}/`} class="hover:text-brand-600">{ev.nombre}</a>
                </h3>
                <p class="text-gray-700 text-sm mt-3 leading-relaxed">{ev.resumen}</p>
                <p class="text-xs text-gray-500 mt-2">Verificado el {textoFechaLarga(ev.verificadoEn)}</p>
              </article>
            ))}
          </div>
        ) : (
          <p class="text-gray-600 bg-warm-50 border border-warm-200 rounded-xl p-5">El archivo todavía no tiene eventos.</p>
        )}
      </section>

      <FormularioSugerencia
        nombre="sugerir-evento"
        titulo="Sugerir un evento"
        introduccion="Pasa la convocatoria de un evento del barrio. La URL de la fuente es obligatoria."
        etiquetaAsunto="Nombre del evento"
      />

      <aside class="mt-10 bg-brand-900 text-white rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl font-bold">¿Organizas algo en el barrio?</h2>
        <p class="text-brand-100 text-sm mt-2 leading-relaxed">
          Lo publicamos cuando hay una página o una noticia que lo convoque.
          Si además quieres que tu local se encuentre en Google, LocalSEOAds es quien lleva el SEO local.
        </p>
        <a
          href={hrefLocal}
          target="_blank"
          rel="noopener"
          class="inline-block mt-4 bg-white text-brand-900 font-semibold px-5 py-2.5 rounded-lg hover:bg-brand-50 transition-colors"
        >
          Ver LocalSEOAds
        </a>
      </aside>
    </div>
  </article>

  <Footer />
</BaseLayout>
