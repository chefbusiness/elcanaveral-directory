---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NegocioCard from "@/components/NegocioCard.astro";
import { generateZonaCategoriaPaths, abreDomingo } from "@/lib/directory";
import { getListicleByCategory, getListicleByCategoryZona, getRankedNegocios } from "@/lib/listicles";
import type { Negocio, Zona, Categoria } from "@/lib/directory";

export function getStaticPaths() {
  return generateZonaCategoriaPaths();
}

interface Props {
  zona: Zona;
  categoria: Categoria;
  negocios: Negocio[];
}

const { zona, categoria, negocios } = Astro.props;
// Prefiere la guia especifica de esta zona; si no, la general de la categoria.
const guia = getListicleByCategoryZona(categoria.slug, zona.slug) || getListicleByCategory(categoria.slug);

// --- Intro y FAQ con datos reales -------------------------------------------
// Estas páginas ya reciben impresiones en Google (la de supermercados de El Cañaveral convierte al
// 2,5 % de CTR) pero no decían nada más que el nombre de la categoría. La intro y las preguntas se
// calculan de los propios datos, así que valen para las ~60 combinaciones zona×categoría sin
// mantenimiento. Solo se afirma lo que los datos sostienen.
const ranking = getRankedNegocios(categoria.slug, { zona: zona.slug });
const mejor = ranking[0]?.negocio;
const abrenDomingo = negocios.filter(abreDomingo);
const conTerraza = negocios.filter((n) => n.terraza);
const conReparto = negocios.filter((n) => n.delivery);
const listaNombres = (l: Negocio[], n = 4) =>
  l.slice(0, n).map((x) => x.name).join(", ") + (l.length > n ? ` y ${l.length - n} más` : "");

const intro = [
  `En ${zona.name} el directorio recoge ${negocios.length} ${negocios.length === 1 ? categoria.name.toLowerCase().replace(/s$/, "") : categoria.name.toLowerCase()}.${mejor ? ` El mejor valorado por nota y volumen de reseñas es ${mejor.name}${mejor.rating ? ` (${mejor.rating} sobre 5${mejor.numReviews ? ` con ${mejor.numReviews} reseñas` : ""})` : ""}.` : ""}`,
  [
    abrenDomingo.length > 0 ? `${abrenDomingo.length} de ellos abren el domingo` : null,
    conTerraza.length > 0 ? `${conTerraza.length} tienen terraza` : null,
    conReparto.length > 0 ? `${conReparto.length} reparten a domicilio` : null,
  ]
    .filter(Boolean)
    .join(", ")
    .replace(/^/, (s) => (s ? s.charAt(0).toUpperCase() + s.slice(1) + ". " : "")) +
    "Abajo tienes las fichas con dirección, teléfono y valoraciones reales de Google.",
];

const faq = [
  mejor && {
    q: `¿Cuál es el mejor valorado de ${categoria.name.toLowerCase()} en ${zona.name}?`,
    a: `${mejor.name}, con ${mejor.rating} sobre 5${mejor.numReviews ? ` y ${mejor.numReviews} reseñas` : ""}. El orden de esta página y de las guías del barrio sale de una puntuación que combina la nota media con el número de reseñas, para que una nota alta con pocas opiniones no adelante a una con cientos.`,
  },
  {
    q: `¿Cuántos ${categoria.name.toLowerCase()} hay en ${zona.name}?`,
    a: `El directorio tiene ${negocios.length} fichas${conTerraza.length > 0 ? `, de las que ${conTerraza.length} declaran terraza` : ""}${conReparto.length > 0 ? ` y ${conReparto.length} servicio a domicilio` : ""}. Todas con dirección, teléfono cuando el negocio lo publica y su ficha completa.`,
  },
  abrenDomingo.length > 0 && {
    q: `¿Alguno abre el domingo en ${zona.name}?`,
    a: `Sí: ${listaNombres(abrenDomingo)}. Lo tienes con su horario exacto en el listado de comercios abiertos los domingos, que se genera con el horario que cada negocio publica en Google.`,
  },
].filter(Boolean) as { q: string; a: string }[];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `${categoria.name} en ${zona.name}`,
  description: `Directorio de ${categoria.name.toLowerCase()} en ${zona.name}.`,
  numberOfItems: negocios.length,
  itemListElement: negocios.slice(0, 20).map((n, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `https://www.elcanaveral.info/${n.category}/${n.slug}/`,
    name: n.name,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.elcanaveral.info/" },
    { "@type": "ListItem", position: 2, name: "Zonas", item: "https://www.elcanaveral.info/zonas/" },
    { "@type": "ListItem", position: 3, name: zona.name, item: `https://www.elcanaveral.info/zona/${zona.slug}/` },
    { "@type": "ListItem", position: 4, name: categoria.name, item: `https://www.elcanaveral.info/zona/${zona.slug}/${categoria.slug}/` },
  ],
};
---

<BaseLayout
  title={`${categoria.name} en ${zona.name}`}
  description={`${categoria.name} en ${zona.name}: direcciones, horarios y reseñas de los negocios de la zona. Encuentra ${categoria.name.toLowerCase()} cerca de ti en ${zona.name}.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />

  <section class="pt-24 pb-16 px-4">
    <div class="max-w-6xl mx-auto">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-gray-700">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/zonas/" class="hover:text-gray-700">Zonas</a>
        <span class="mx-2">/</span>
        <a href={`/zona/${zona.slug}/`} class="hover:text-gray-700">{zona.name}</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900">{categoria.name}</span>
      </nav>

      <div class="mb-8">
        <h1 class="text-3xl font-bold">
          {categoria.icon && <span class="mr-2">{categoria.icon}</span>}
          {categoria.name} en {zona.name}
        </h1>
        <p class="text-gray-600 mt-2">
          Directorio de {categoria.name.toLowerCase()} en {zona.name}.
          {categoria.description}
        </p>
        <p class="text-sm text-gray-400 mt-1">{negocios.length} negocios</p>
      </div>

      <!-- Intro con datos de esta zona (calculada, no escrita a mano) -->
      <div class="bg-white rounded-xl border border-warm-200 p-5 mb-6 text-sm text-gray-700 leading-relaxed">
        {intro.map((p) => (
          <p class={intro.indexOf(p) > 0 ? "mt-2" : ""}>{p}</p>
        ))}
      </div>

      {guia && (
        <a
          href={`/blog/${guia.slug}/`}
          class="block mb-8 bg-gradient-to-r from-brand-50 to-warm-100 border border-brand-100 rounded-xl p-4 sm:p-5 hover:border-brand-200 transition-colors group"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <span class="text-xs font-semibold text-accent-600 uppercase tracking-wide">Guía del barrio</span>
              <p class="font-bold text-brand-900 group-hover:text-brand-600 leading-snug mt-0.5">{guia.h1}</p>
              <p class="text-sm text-gray-500 mt-0.5">Ranking por las valoraciones reales de Google</p>
            </div>
            <span class="shrink-0 text-sm font-semibold text-brand-600">Ver guía &rarr;</span>
          </div>
        </a>
      )}

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {negocios.map((negocio) => (
          <NegocioCard negocio={negocio} />
        ))}
      </div>

      {faq.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-bold text-brand-900 mb-5">
            Preguntas frecuentes sobre {categoria.name.toLowerCase()} en {zona.name}
          </h2>
          <div class="space-y-3">
            {faq.map((f) => (
              <details class="bg-white rounded-xl border border-warm-200 p-4 group">
                <summary class="font-semibold text-gray-800 cursor-pointer list-none flex items-center justify-between">
                  {f.q}
                  <span class="text-brand-400 group-open:rotate-180 transition-transform">&#9662;</span>
                </summary>
                <p class="text-gray-600 text-sm mt-3 leading-relaxed">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>

  <Footer />
</BaseLayout>
