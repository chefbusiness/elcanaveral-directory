---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import actualidadData from "@/data/actualidad.json";

export function getStaticPaths() {
  const today = new Date();
  return (actualidadData as any).posts
    .filter((p: any) => new Date(p.date) <= today)
    .map((p: any) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props as any;
const fmt = (iso: string) => new Date(iso).toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
const base = "https://www.elcanaveral.info";
const httpUrl = (value: unknown): string | null =>
  typeof value === "string" && /^https?:\/\//.test(value) ? value : null;
// Opcional. Las noticias anteriores (Guppy, vivienda, etc.) no traen imagen:
// sin este objeto la página sigue siendo solo texto y el og:image es el del sitio.
const imagen =
  post.image && typeof post.image.src === "string" && post.image.src.startsWith("/")
    ? post.image
    : null;
const credito = imagen?.credit && typeof imagen.credit === "object" ? imagen.credit : null;
// Misma entidad que la Organization de la home (src/pages/index.astro): sin el
// @id, cada noticia declaraba una Organization distinta del mismo editor y un
// LLM veia dos marcas donde hay una. Se mantienen name+logo inline porque el
// rich result de Article exige publisher con nombre y logo.
const orgId = `${base}/#organization`;
const publisher = {
  "@id": orgId,
  "@type": "Organization",
  name: "El Cañaveral Info",
  url: `${base}/`,
  logo: { "@type": "ImageObject", url: `${base}/favicon-512.png`, width: 512, height: 512 },
};

const articleImage = imagen
  ? {
      "@type": "ImageObject",
      url: `${base}${imagen.src}`,
      ...(typeof imagen.width === "number" ? { width: imagen.width } : {}),
      ...(typeof imagen.height === "number" ? { height: imagen.height } : {}),
      ...(typeof imagen.alt === "string" && imagen.alt ? { caption: imagen.alt } : {}),
      ...(credito?.author
        ? {
            creditText: [credito.author, credito.source, credito.licence].filter(Boolean).join(", "),
            creator: {
              "@type": "Person",
              name: credito.author,
              ...(httpUrl(credito.authorUrl) ? { url: credito.authorUrl } : {}),
            },
          }
        : {}),
      ...(httpUrl(credito?.licenceUrl) ? { license: credito.licenceUrl } : {}),
    }
  : null;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.updated || post.date,
  ...(articleImage ? { image: articleImage } : {}),
  author: publisher,
  publisher,
  mainEntityOfPage: `${base}/actualidad/${post.slug}/`,
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${base}/` },
    { "@type": "ListItem", position: 2, name: "Actualidad", item: `${base}/actualidad/` },
    { "@type": "ListItem", position: 3, name: post.title, item: `${base}/actualidad/${post.slug}/` },
  ],
};
---

<BaseLayout title={post.title} description={post.excerpt} image={imagen?.src}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Header />

  <article class="pt-24 pb-16 px-4">
    <div class="max-w-3xl mx-auto">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-brand-600">Inicio</a>
        <span class="mx-1.5 text-gray-300">/</span>
        <a href="/actualidad/" class="hover:text-brand-600">Actualidad</a>
        <span class="mx-1.5 text-gray-300">/</span>
        <span class="text-gray-900">Noticia</span>
      </nav>

      <header class="mb-6">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="text-sm text-gray-400">{fmt(post.date)}</span>
          {(post.tags || []).map((t: string) => (
            <span class="text-[11px] bg-brand-50 text-brand-700 px-2 py-0.5 rounded">{t}</span>
          ))}
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold text-brand-900 leading-tight">{post.title}</h1>
        {imagen && (
          <figure class="mt-6">
            <img
              src={imagen.src}
              alt={typeof imagen.alt === "string" ? imagen.alt : ""}
              width={imagen.width}
              height={imagen.height}
              class="w-full h-auto rounded-xl border border-warm-200"
              fetchpriority="high"
            />
            {credito && (credito.author || credito.source || credito.licence) && (
              <figcaption class="mt-2 text-xs text-gray-500 leading-relaxed">
                Foto: {httpUrl(credito.authorUrl) ? (
                  <a href={credito.authorUrl} target="_blank" rel="noopener" class="text-brand-600 hover:text-brand-700">{credito.author}</a>
                ) : (
                  credito.author
                )}{credito.source && (
                  <>, {httpUrl(credito.sourceUrl) ? (
                    <a href={credito.sourceUrl} target="_blank" rel="noopener" class="text-brand-600 hover:text-brand-700">{credito.source}</a>
                  ) : (
                    credito.source
                  )}</>
                )}{credito.licence && (
                  <>, licencia {httpUrl(credito.licenceUrl) ? (
                    <a href={credito.licenceUrl} target="_blank" rel="license noopener" class="text-brand-600 hover:text-brand-700">{credito.licence}</a>
                  ) : (
                    credito.licence
                  )}</>
                )}.
                {credito.note && <span> {credito.note}</span>}
              </figcaption>
            )}
          </figure>
        )}
        <p class="text-gray-600 leading-relaxed mt-4 text-lg">{post.lead}</p>
      </header>

      {post.datosClave && post.datosClave.length > 0 && (
        <div class="bg-brand-50 border border-brand-100 rounded-xl p-5 mb-8">
          <p class="font-semibold text-brand-700 mb-2 text-sm uppercase tracking-wide">Datos clave</p>
          <ul class="space-y-1.5 text-sm text-gray-700">
            {post.datosClave.map((d: string) => (
              <li class="flex gap-2"><span class="text-accent-500">✓</span> {d}</li>
            ))}
          </ul>
        </div>
      )}

      <div class="prose-custom space-y-6">
        {post.secciones.map((s: any) => (
          <section>
            {s.h2 && <h2 class="text-xl sm:text-2xl font-bold text-brand-900 mb-3">{s.h2}</h2>}
            {s.parrafos.map((p: string) => (
              <p class="text-gray-700 leading-relaxed mb-3 [&_a]:text-brand-600 [&_a:hover]:text-brand-700 [&_a]:underline [&_a]:underline-offset-2" set:html={p} />
            ))}
          </section>
        ))}
      </div>

      {post.fuentes && post.fuentes.length > 0 && (
        <div class="mt-10 pt-6 border-t border-warm-200">
          <p class="text-sm text-gray-500">
            <span class="font-semibold text-gray-700">Fuentes:</span>
            {post.fuentes.map((f: any, i: number) => (
              <>
                {i > 0 ? " · " : " "}
                <a href={f.url} target="_blank" rel="noopener" class="text-brand-600 hover:text-brand-700">{f.name}</a>
              </>
            ))}
          </p>
        </div>
      )}

      <!-- Cross-link -->
      <div class="mt-8 bg-warm-50 border border-warm-100 rounded-xl p-5 text-sm text-gray-700">
        Sigue explorando el barrio: <a href="/el-canaveral/" class="text-brand-600 font-medium">la guía para vivir en El Cañaveral</a>,
        el <a href="/directorio/" class="text-brand-600 font-medium">directorio de negocios</a> y <a href="/actualidad/" class="text-brand-600 font-medium">más actualidad</a>.
      </div>

      <p class="text-center mt-8">
        <a href="/actualidad/" class="text-sm font-medium text-brand-600 hover:text-brand-700">&larr; Toda la actualidad del barrio</a>
      </p>
    </div>
  </article>

  <Footer />
</BaseLayout>
