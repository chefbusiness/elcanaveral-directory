---
import "@/styles/global.css";
import TopBanner from "@/components/TopBanner.astro";
import CookieConsent from "@/components/CookieConsent.astro";
import { loadCategorias, loadZonas } from "@/lib/directory";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = "/images/og-default.webp", noindex = false } = Astro.props;
const siteName = "elcanaveral.info";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const fullTitle = `${title} | ${siteName}`;

// --- Entidad del sitio en TODAS las páginas ----------------------------------
// La Organization estaba solo en la home: ahora viaja con cada página para que un buscador o un LLM
// sepa quién publica lo que está leyendo, con el mismo @id en todo el sitio (una sola entidad, no
// 442 marcas distintas). La home añade además el nodo WebSite.
const SITE_URL = "https://www.elcanaveral.info";
const orgId = `${SITE_URL}/#organization`;
const zonas = loadZonas();
const categorias = loadCategorias();
const municipios = [...new Set(zonas.map((z) => z.municipality).filter(Boolean))];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": orgId,
  name: "El Cañaveral Info",
  alternateName: ["El Canaveral Info", "elcanaveral.info"],
  url: `${SITE_URL}/`,
  logo: { "@type": "ImageObject", url: `${SITE_URL}/favicon-512.png`, width: 512, height: 512 },
  description:
    "Directorio hiperlocal de negocios, comercios y servicios de El Cañaveral (Vicálvaro, Madrid), Coslada y San Fernando de Henares.",
  email: "local@elcanaveral.info",
  areaServed: municipios.map((m) => ({ "@type": "City", name: m })),
  knowsAbout: categorias.filter((c) => (c.count ?? 0) > 0).map((c) => c.name),
  // Con @id para que no se genere un segundo nodo Organization anónimo en cada página.
  parentOrganization: { "@type": "Organization", "@id": "https://localseoads.com/#organization", name: "LocalSEOAds", url: "https://localseoads.com" },
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "customer support",
      email: "local@elcanaveral.info",
      url: `${SITE_URL}/contacto/`,
      availableLanguage: ["es"],
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />
  </head>
  <body>
    <TopBanner />
    <slot />
    <CookieConsent />
  </body>
</html>
